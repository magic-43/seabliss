# Normalize line endings to LF in the repository, check out as-is on all platforms
* text=auto eol=lf

# Binary files - no line ending conversion
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

